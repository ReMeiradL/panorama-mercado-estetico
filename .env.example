# ============================================================
# Jornada Data Engineer & Analytics — Projeto
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o .env (com valores reais) para o Git!
# ============================================================

# --- Fontes locais (arquivos carregados do computador) ---
RAW_DATA_DIR=./dados_brutos
RAW_PDF_DIR=./dados_brutos/pdf
RAW_CSV_DIR=./dados_brutos/csv

# --- MinIO (data lake local, sobe via docker-compose) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=troque-esta-senha
BUCKET_DATALAKE=projeto-ai

# Um bucket por camada da arquitetura medalhão
BUCKET_RAW=raw
BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold

# --- PostgreSQL Data (projeto), sobe via docker-compose ---
PG_DATA_USER=postgres
PG_DATA_PASSWORD=troque-esta-senha
PG_DATA_DB=projeto-ai
PG_DATA_HOST=localhost
PG_DATA_PORT=5434
